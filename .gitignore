# =========================
# Project-specific ignores
# =========================
# Keep only patterns that apply to this repository

# Go coverage and test artifacts
coverage.out
*.coverprofile

# Dependency directory (if you vendor deps locally)
vendor/

# Logs
*.log

# =========================
# DATABASE
# =========================
# Ignore any sqlite files
*.db
*.sqlite
*.sqlite3

# Project DB (explicit)
/database.db
database/forum.db

